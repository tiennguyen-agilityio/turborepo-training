{
  "name": "turborepo-training",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "turbo run dev",
    "start": "turbo run start",
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf node_modules && rm -rf ./apps/*/node_modules && pnpm store prune",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check --cache-dir=.turbo/typecheck",
    "prepare": "husky"
  },
  "dependencies": {
    "next": "15.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "turbo": "^2.5.5"
  }
}
