{
  "name": "turborepo-training",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "turbo run dev",
    "start": "turbo run start",
    "build": "turbo run build --filter=...[HEAD^1] --concurrency=2",
    "dev:web": "turbo run dev --filter=web",
    "start:web": "turbo run build start --filter=web",
    "build:web": "turbo run build --filter=web",
    "dev:mobile": "turbo run dev --filter=mobile",
    "build:android": "turbo run build:android --filter=mobile",
    "build:android-debug": "turbo run build:android-debug --filter=mobile",
    "clean": "turbo run clean && rm -rf node_modules && rm -rf ./apps/*/node_modules && pnpm store prune",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check --cache-dir=.turbo/typecheck",
    "prepare": "husky"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.3",
    "effect": "^3.17.13",
    "next": "15.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "^0.81.1",
    "tamagui": "^1.132.20",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "babel-plugin-module-resolver": "^5.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "turbo": "^2.5.5"
  }
}
