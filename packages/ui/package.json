{
  "name": "@repo/ui",
  "version": "0.0.0",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "dist/index",
  "exports": {
    "./styles.css": "./dist/index.css",
    "./components/*": "./src/components/*/index.tsx",
    "./sections/*": "./src/sections/*/index.tsx",
    "./layout/*": "./src/layout/*/index.tsx",
    "./layout": "./src/layout/index.tsx",
    "./components/ui/*": "./src/components/ui/*.tsx",
    "./icons/*": "./src/components/Icons/*.tsx",
    "./themes/styles.css": "./src/themes/styles.css",
    "./providers/*": "./src/providers/*.tsx",
    "./fonts": "./src/assets/fonts.ts"
  },
  "scripts": {
    "build:styles": "tailwindcss -i ./src/themes/styles.css -o ./dist/index.css",
    "dev:styles": "tailwindcss -i ./src/themes/styles.css -o ./dist/index.css --watch"
  },
  "dependencies": {
    "@clerk/elements": "^0.23.38",
    "@clerk/nextjs": "^6.23.2",
    "@clerk/themes": "^2.2.53",
    "@hookform/resolvers": "^5.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-toggle": "^1.1.9",
    "@repo/constants": "*",
    "@repo/types": "*",
    "@repo/utils": "*",
    "class-variance-authority": "^0.7.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "next": "*",
    "next-themes": "*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.61.1",
    "sonner": "^2.0.6",
    "svix": "^1.69.0",
    "zod": "^4.0.13"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/prettier-config": "*",
    "@repo/tailwind-config": "*",
    "@repo/typescript-config": "*",
    "@tailwindcss/postcss": "*",
    "@tailwindcss/cli": "^4.1.12",
    "tailwindcss": "*",
    "@types/react": "19.1.10"
  }
}
